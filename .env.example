# =========================================================
# docintel — environment configuration
# Copy to .env and fill in. Values marked TODO(user) are
# placeholders — this platform will not guess them.
# =========================================================

# ---- App ----
APP_NAME=docintel
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# ---- NVIDIA API ----
NVIDIA_API_KEY=                # TODO(user): required, no default
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# TODO(user): confirm exact NVIDIA generation model ID (e.g. an nvidia/nemotron variant)
NVIDIA_GENERATION_MODEL=
# TODO(user): confirm exact NVIDIA embedding model ID
NVIDIA_EMBEDDING_MODEL=
NVIDIA_EMBEDDING_DIMENSIONS=  # TODO(user): must match the embedding model above

# ---- Qdrant ----
QDRANT_MODE=local              # local | cloud   -- TODO(user): confirm which
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                # required only if QDRANT_MODE=cloud

# ---- Storage layer ----
STORAGE_BACKEND=local          # local | s3      -- TODO(user): confirm if S3 needed
RAW_FILES_DIR=./data/raw
CACHE_DIR=./data/cache
HASH_REGISTRY_PATH=./data/cache/hash_registry.sqlite

# ---- Ingestion ----
OCR_ENGINE=tesseract           # placeholder default; swappable via loader plugin
MAX_UPLOAD_FILE_MB=50

# ---- Chunking ----
CHUNK_STRATEGY=recursive       # recursive | semantic | structural
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ---- Retrieval ----
HYBRID_SEARCH_ALPHA=0.5        # weight between sparse/dense; TODO(user): tune per KB
RERANK_TOP_K=10
RETRIEVAL_TOP_K=5

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
